# Server
PORT=4000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API with cookies.
# Leave empty in development. Set this in production if the SPA and API are
# served from different origins; same-origin requests work without it.
CORS_ORIGIN=

# SQLite database (created and seeded automatically when missing).
# Relative paths are resolved from the backend/ directory.
DATABASE_PATH=./data/screening.db

# Optional LLM assist for job-description intake only.
# Scoring is deterministic and always falls back to local evidence matching.
# Leave these blank to run fully offline.
AI_PROVIDER=
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Upload limits
MAX_BULK_UPLOAD_FILES=500
