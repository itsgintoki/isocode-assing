# Server Port & Mode
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL + SQLite Dual-Engine)
# To use PostgreSQL, spin up docker-compose or provide DATABASE_URL.
# If left commented or unset, system seamlessly runs on embedded SQLite (WAL mode) with zero configuration!
# DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/companya_screening
DB_TYPE=sqlite
DATABASE_PATH=./backend/data/screening.db

# AI Model Configuration (Optional)
# Fully dynamic model routing: pass any model (e.g. gpt-5, o3, gemini-2.5-flash, gemini-3.0, claude-4-sonnet)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Upload Limits
MAX_BULK_UPLOAD_FILES=500
