# Server Port
PORT=4000

# Environment Mode
NODE_ENV=development

# SQLite Database Location
DATABASE_PATH=./backend/data/screening.db

# Optional AI LLM Provider Keys (System has high-fidelity heuristic/NLP engine by default)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Upload Limits
MAX_BULK_UPLOAD_FILES=500
