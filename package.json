{
  "name": "isocode-assing",
  "version": "1.0.0",
  "description": "Shortlist — AI-assisted resume screening and client shortlist portal",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run --prefix backend dev\" \"npm run --prefix frontend dev\"",
    "build": "npm run --prefix frontend build",
    "seed": "node backend/src/db/seed.js",
    "test": "npm run --prefix backend test",
    "tdd:pdf": "node scripts/generate_tdd_pdf.js",
    "package-zip": "node scripts/generate_submission_zip.js"
  },
  "keywords": [
    "recruitment",
    "resume-screening",
    "shortlist",
    "react",
    "express",
    "sqlite"
  ],
  "author": "Ankit Sinha",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^10.0.6"
  },
  "devDependencies": {
    "marked": "^16.4.2"
  }
}
